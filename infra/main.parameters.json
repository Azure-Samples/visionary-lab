{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "DOCKER_IMAGE_BACKEND": {
      "value": "${SERVICE_BACKEND_IMAGE_NAME}"
    },
    "DOCKER_IMAGE_FRONTEND": {
      "value": "${SERVICE_FRONTEND_IMAGE_NAME}"
    },
    "aiFoundryName": {
      "value": "${AI_FOUNDRY_NAME}"
    },
    "aiFoundryLocation": {
      "value": "${AI_FOUNDRY_LOCATION}"
    },
    "LLM_DEPLOYMENT": {
      "value": "${LLM_DEPLOYMENT}"
    },
    "IMAGEGEN_2_DEPLOYMENT": {
      "value": "${IMAGEGEN_2_DEPLOYMENT}"
    },
    "FLUX_KONTEXT_DEPLOYMENT": {
      "value": "${FLUX_KONTEXT_DEPLOYMENT}"
    },
    "AUTH_CLIENT_ID": {
      "value": "${AUTH_CLIENT_ID}"
    },
    "AUTH_CLIENT_SECRET": {
      "value": "${AUTH_CLIENT_SECRET}"
    },
    "AUTH_ISSUER": {
      "value": "${AUTH_ISSUER}"
    },
    "frontDoorName": {
      "value": "${AZURE_FRONT_DOOR_NAME}"
    },
    "frontendCustomDomain": {
      "value": "${FRONTEND_CUSTOM_DOMAIN}"
    },
    "frontendCertificateId": {
      "value": "${FRONTEND_CERTIFICATE_ID}"
    }
  }
}
