# Visionary Lab API - Environment Variables
# Authentication: Uses Azure Managed Identity (DefaultAzureCredential)
# For local development, run `az login` before starting the app.

MODEL_PROVIDER=azure

# AI Foundry endpoint (unified for all AI services)
# This is the endpoint of your Azure AI Foundry resource.
# Find it in Azure Portal > AI Foundry resource > Overview > Endpoint
# ----------------------------------------------------------------------
AI_FOUNDRY_ENDPOINT=https://your-foundry-name.cognitiveservices.azure.com/

# Model deployment names
# These must match the deployment names created in your AI Foundry resource.
# ----------------------------------------------------------------------
LLM_DEPLOYMENT=gpt-4o
IMAGEGEN_2_DEPLOYMENT=gpt-image-2
FLUX_KONTEXT_DEPLOYMENT=flux-kontext-pro

# Configure the image deployments available in your AI Foundry resource.

# Azure Cosmos DB for metadata storage (managed identity — no keys)
# ----------------------------------------------------------------------
AZURE_COSMOS_DB_ENDPOINT=
AZURE_COSMOS_DB_ID=VisionaryLabDB
AZURE_COSMOS_CONTAINER_ID=visionarylab

# Blob Storage for asset storage. scripts/dev.sh starts Azurite automatically
# for the development shortcut below. Clear the connection string to use the
# Azure URL/account settings through DefaultAzureCredential instead.
# ----------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_BLOB_SERVICE_URL=https://your-storage-account.blob.core.windows.net/
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_BLOB_IMAGE_CONTAINER=images

# Durable image-generation jobs. Local development defaults to the in-memory
# queue/store so the API and workers can run in one process. Set mode to `azure`
# only when the Queue and Cosmos endpoints are reachable from your machine.
AZURE_STORAGE_QUEUE_URL=
AZURE_STORAGE_QUEUE_NAME=image-generation-jobs
AZURE_STORAGE_POISON_QUEUE_NAME=image-generation-jobs-poison
IMAGE_JOB_MODE=memory
IMAGE_JOB_ROLE=all
IMAGE_JOB_CONCURRENCY=2

# Docker Compose cannot reuse the host Azure CLI session. When running the
# backend in Docker, provide a service principal through the standard Azure
# Identity variables below. They are not needed for ./scripts/dev.sh.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=

# Azure Front Door (optional)
# ----------------------------------------------------------------------
# AZURE_FRONT_DOOR_ENDPOINT=https://your-frontdoor.azurefd.net
# AZURE_FRONT_DOOR_ENABLED=false
